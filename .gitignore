# Secrets — never commit
.env
.github_token
.claude/

# Project-local Python deps (no venv possible; see CLAUDE.md)
pylibs/
__pycache__/
*.pyc

# Node / site build
node_modules/
dist/
.astro/

# Invariant 6: no image files are committed, except pitch-black frames.
# Those are the deliberate exception — force-add them explicitly (git add -f)
# so committing an image is always a conscious act, never an accident.
*.jpg
*.jpeg
*.png
*.webp
*.gif
*.bmp
*.tiff

# Shell init files the sandbox synthesizes in its container home — these are
# visible from inside the sandbox but are not part of the project. Several
# appear as bind-mounted character devices and must never be indexed.
.bashrc
.bash_profile
.profile
.zprofile
.zshrc
.gitconfig
.ripgreprc
.gitmodules
.mcp.json
.idea
.vscode

# Scratch / probe output — Stage 0 is throwaway and may hold raw scraped
# records that have not been PII-stripped yet (invariant 1).
probe/out/
probe/cache/
scratch/
*.log
